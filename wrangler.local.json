{
  "name": "visionhardware-local-only",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "visionhardware-local-only",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "vars": {
    "ENVIRONMENT": "local",
    "INQUIRIES_ENABLED": "true",
    "ALLOWED_ORIGINS": "http://127.0.0.1:8788",
    "TURNSTILE_MODE": "mock",
    "MAIL_PROVIDER": "mock",
    "ALLOW_EMAIL_SEND": "false"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}